POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=market_data
DATABASE_URL=postgresql://postgres:postgres@db:5432/market_data
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,SUIUSDT
POLL_SECONDS=10
METRICS_PORT=9100
LOG_LEVEL=INFO
ENABLE_GAP_BACKFILL=true
BACKFILL_MAX_CANDLES_PER_RUN=500
REST_BACKFILL_SLEEP_SECONDS=0.2
