# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=market_data
POSTGRES_PORT=5432

# Internal service connectivity
DATABASE_URL=postgresql://postgres:postgres@db:5432/market_data

# Ingestor
SYMBOL=BTCUSDT
POLL_SECONDS=10
METRICS_PORT=9100
LOG_LEVEL=INFO
ENABLE_GAP_BACKFILL=true
BACKFILL_MAX_CANDLES_PER_RUN=500
REST_BACKFILL_SLEEP_SECONDS=0.2

# API
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Research UI
RESEARCH_UI_PORT=8501
API_BASE_URL=http://api:8000
BACKTEST_LIST_LIMIT=100

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d

# cAdvisor
CADVISOR_PORT=8080

# Grafana
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

PROMETHEUS_URL=http://prometheus:9090/-/healthy
GRAFANA_URL=http://grafana:3000/api/health
CADVISOR_URL=http://cadvisor:8080/metrics