{
  "id": null,
  "title": "Shark Bay Operational Monitoring",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "panels": [
    {
      "type": "row",
      "title": "Ingestion Health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Latest candle timestamp",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "(latest_candle_timestamp{job=\"ingestor\"} unless latest_candle_timestamp{job=\"ingestor\"} == 0) * 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "noValue": "No data"
        }
      }
    },
    {
      "type": "stat",
      "title": "Data lag seconds",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "clamp_min(time() - (latest_candle_timestamp{job=\"ingestor\"} unless latest_candle_timestamp{job=\"ingestor\"} == 0), 0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          },
          "decimals": 0,
          "noValue": "No data"
        }
      }
    },
    {
      "type": "stat",
      "title": "Ingestion errors (5m)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "increase(ingest_error_total[5m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "DB connection status",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "db_connection_status{service=\"ingestor\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "row",
      "title": "Data Quality",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "stat",
      "title": "Current gap count",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "data_quality_gap_count{job=\"ingestor\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "type": "stat",
      "title": "Current duplicate count",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 6
      },
      "targets": [
        {
          "expr": "data_quality_duplicate_count{job=\"ingestor\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "type": "stat",
      "title": "Current invalid OHLC count",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "expr": "data_quality_invalid_ohlc_count{job=\"ingestor\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "type": "stat",
      "title": "Current invalid volume count",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "data_quality_invalid_volume_count{job=\"ingestor\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "type": "stat",
      "title": "Current future timestamp count",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "expr": "data_quality_future_timestamp_count{job=\"ingestor\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "type": "row",
      "title": "Cumulative Validation Event Counters",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "stat",
      "title": "Candle inserts rate",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 6
      },
      "targets": [
        {
          "expr": "rate(candle_insert_total[5m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        }
      }
    },
    {
      "type": "row",
      "title": "Backfill Recovery",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      }
    },
    {
      "type": "stat",
      "title": "Backfill request count (1h)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "increase(rest_backfill_requested_total{job=\"ingestor\"}[1h])"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Backfill completed count (1h)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 12
      },
      "targets": [
        {
          "expr": "increase(rest_backfill_completed_total{job=\"ingestor\"}[1h])"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Backfill failed count (1h)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "expr": "increase(rest_backfill_failed_total{job=\"ingestor\"}[1h])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Last backfill candle count",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "last_backfill_candle_count{job=\"ingestor\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Websocket reconnect count (1h)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 12
      },
      "targets": [
        {
          "expr": "increase(websocket_reconnect_total[1h])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Backfill candles inserted (1h)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 12
      },
      "targets": [
        {
          "expr": "increase(rest_backfill_candles_inserted_total{job=\"ingestor\"}[1h])"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
