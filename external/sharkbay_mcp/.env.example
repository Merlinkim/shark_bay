# Required: remote SharkBay FastAPI base URL. Do not include a trailing slash.
SHARKBAY_BASE_URL=https://your-sharkbay-api-server

# Optional: explicit OpenAPI schema URL. Defaults to ${SHARKBAY_BASE_URL}/openapi.json.
SHARKBAY_OPENAPI_URL=https://your-sharkbay-api-server/openapi.json

# Optional: bearer token/API key sent as the Authorization header value.
# If your API expects "Bearer <token>", include the full Bearer prefix here.
SHARKBAY_API_KEY=

# Optional request timeout in seconds. Defaults to 10.
SHARKBAY_TIMEOUT_SECONDS=10

# Optional maximum response bytes returned by call_endpoint. Defaults to 1048576 (1 MiB).
SHARKBAY_MAX_RESPONSE_BYTES=1048576

# Optional local OpenAPI fallback file within this folder. Defaults to openapi.json.
SHARKBAY_LOCAL_OPENAPI_FILE=openapi.json
